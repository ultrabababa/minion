#!/bin/bash
#
#   hotstuff - run hotstuff on a worker node
#
#   Actions: deploy, start, stop, kill
#   The kill and start actions accept optional 0-indexed node indices as
#   arguments (matching the observer.py convention used by STABL).
#   Each worker maps its IP octet to a 0-based index: index = octet - 1.
#

set -e

script_name='hotstuff'
install_root="${HOME}/install/hotstuff"
deploy_root="${HOME}/deploy/hotstuff"

# Determine the 1-based node ID from the IP last octet (10.30.10.x => x).
# The hotstuff binary uses 1-based IDs (--id flag).
# The 0-based observer index = node_id - 1.
local_ip_init=$(hostname -I | awk '{print $1}')
node_id=$(echo "${local_ip_init}" | awk -F. '{print $4}')
node_index=$((node_id - 1))
node_root="${deploy_root}/n${node_index}"

# Utility functions
fatal() {
    local msg="$1" ; shift
    exec >&2
    echo "${script_name}: ${msg}"
    exit 1
}

deploy() {
    mkdir -p "${node_root}"
    # No complex keys generation here anymore, the server binary handles deterministic keys.
}

# _start_node starts the hotstuff process in the local node directory.
_start_node() {
    local dir="$1"
    [ -d "${dir}" ] || return 0

    cd "${dir}"

    # Comma-separated list of all 10 replica IPs
    local ips="10.30.10.1,10.30.10.2,10.30.10.3,10.30.10.4,10.30.10.5,10.30.10.6,10.30.10.7,10.30.10.8,10.30.10.9,10.30.10.10"

    nohup "${install_root}/hotstuff" server --id "${node_id}" --ips "${ips}" --log-level debug > out 2> err < /dev/null &
    echo $! > hotstuff.pid
}

start() {
    local dirs

    dirs=("${deploy_root}/n"*)
    if [ $# -gt 0 ] ; then
        dirs=("${@/#/${deploy_root}/n}")
    fi

    for dir in "${dirs[@]}" ; do
        if [ -d "${dir}" ] ; then
            _start_node "${dir}"
        fi
    done
}

# _kill sends a signal to the hotstuff process, with fallback to SIGKILL.
_kill() {
    local sig="$1" ; shift
    local dir pid dead dirs

    dirs=("${deploy_root}/n"*)
    if [ $# -gt 0 ] ; then
        dirs=("${@/#/${deploy_root}/n}")
    fi

    for dir in "${dirs[@]}" ; do
        if [ ! -d "${dir}" ] ; then
            continue
        elif [ ! -f "${dir}/hotstuff.pid" ] ; then
            continue
        fi

        pid="$(cat "${dir}/hotstuff.pid")"

        if echo "${pid}" | grep -Pq '^\d+$' ; then
            kill "${sig}" ${pid} 2> '/dev/null' || true
        fi

        dead=0
        for i in $(seq 1 5) ; do
            if ! ps ${pid} > '/dev/null' 2>&1 ; then
                dead=1
                break
            fi
            sleep 1
        done

        if [ ${dead} -eq 0 ] ; then
            kill -KILL ${pid} 2> '/dev/null' || true
        fi

        rm -f "${dir}/hotstuff.pid"
    done
}

nkill() {
    _kill -KILL "$@"
}

stop() {
    _kill -INT "$@"
    pkill -9 hotstuff 2>/dev/null || true
}

if [ $# -lt 1 ] ; then
    fatal "missing action operand"
fi

action="$1" ; shift

case "${action}" in
    'deploy')
        deploy "$@"
        ;;
    'start')
        start "$@"
        ;;
    'stop')
        stop "$@"
        ;;
    'kill')
        nkill "$@"
        ;;
    *)
        fatal "unknown action: '${action}'"
        ;;
esac
