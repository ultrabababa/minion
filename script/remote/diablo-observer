#!/bin/bash

set -e

script_name='diablo-observer'
deploy_root="${HOME}/deploy/diablo-observer"

fatal() {
	local msg="$1" ; shift

	exec >&2

	echo "${script_name}: ${msg}"
	exit 1
}

