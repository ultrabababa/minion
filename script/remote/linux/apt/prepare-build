#!/usr/bin/env bash
#
#   prepare-install - prepare an apt based system to install packages
#

set -e

load_env_file() {
    local file="$1"

    if [ -f "$file" ]; then
        set -a
        . "$file"
        set +a
    fi
}

load_env_file /etc/environment
load_env_file "$HOME/.minion-env"

if ! command -v 'sudo' > '/dev/null' ; then
    echo "Cannot find command 'sudo'" >&2
    exit 1
fi


mp="${PWD}"
while ! mountpoint --quiet "${mp}" ; do
    mp="${mp%/*}"
    if [ "x${mp}" = 'x' ] ; then
	mp='/'
    fi
done
part="$(mount | grep ' on '"${mp}"' ' | cut -d' ' -f1)"
dev="$(basename "$(readlink -f "/sys/class/block/${part##*/}/..")")"
if command -v growpart >/dev/null 2>&1 ; then
    sudo growpart "/dev/${dev}" 1 || true
fi
sudo resize2fs "${part}" || true


while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 ; do
    echo 'Waiting for release of dpkg/apt locks'
    sleep 5
done

update_ok=0
for attempt in 1 2 3 4 5 ; do
    if sudo -n apt-get -o DPkg::Lock::Timeout=1200 -o Acquire::Retries=3 update -yy ; then
        update_ok=1
        break
    fi

    if [ "${attempt}" -eq 1 ] ; then
        sudo bash -lc 'shopt -s nullglob; for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do [ -f "$f" ] || continue; sed -i "s|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g; s|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g" "$f"; done'
    fi

    sleep $((attempt * 5))
done

if [ "${update_ok}" -ne 1 ] ; then
    echo 'apt-get update failed after retries' >&2
    exit 1
fi

while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 ; do
    echo 'Waiting for release of dpkg/apt locks'
    sleep 5
done

sudo -n apt-get -o DPkg::Lock::Timeout=1200 install -yy 'psmisc' 'build-essential' 'direnv' 'git' 'curl'

clone_asdf() {
    for attempt in 1 2 3 4 5 ; do
        rm -rf "$HOME/.asdf"
        if git -c http.version=HTTP/1.1 clone --depth 1 --branch v0.14.0 https://github.com/asdf-vm/asdf.git "$HOME/.asdf" ; then
            return 0
        fi
        sleep $((attempt * 5))
    done

    echo 'failed to clone asdf after retries' >&2
    return 1
}

if [ ! -f "$HOME/.asdf/asdf.sh" ]; then
    clone_asdf
fi
. "$HOME/.asdf/asdf.sh"
plugin_name='direnv'
status_code=0
if ! asdf plugin list | grep -qx "$plugin_name" ; then
    for attempt in 1 2 3 4 5 ; do
        if asdf plugin add "$plugin_name" "https://github.com/asdf-community/asdf-direnv.git" ; then
            status_code=0
            break
        fi
        status_code=$?
        sleep $((attempt * 5))
    done
    if [ "$status_code" -ne 0 ]; then
        echo "Failed to add '$plugin_name' plugin to asdf" >&2
        exit 1
    fi
fi
asdf direnv setup --shell bash --version system
