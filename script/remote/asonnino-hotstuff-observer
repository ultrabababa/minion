#!/usr/bin/env python3
import argparse
import json
import os
import re
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


SAMPLE_RE = re.compile(r"Batch\s+([A-Za-z0-9+/=]+)\s+contains sample tx\s+(\d+)")
COMMIT_RE = re.compile(r"Committed\s+B\d+\s+->\s+([A-Za-z0-9+/=]+)")


class Tracker:
    def __init__(self):
        self.lock = threading.Lock()
        self.tx_to_batch = {}
        self.tx_state = {}

    def mark_batch_contains(self, batch, tx_id):
        with self.lock:
            self.tx_to_batch[tx_id] = batch
            self.tx_state.setdefault(tx_id, "pending")

    def mark_batch_committed(self, batch):
        with self.lock:
            for tx_id, b in list(self.tx_to_batch.items()):
                if b == batch:
                    self.tx_state[tx_id] = "committed"

    def state(self, tx_id):
        with self.lock:
            return self.tx_state.get(tx_id, "pending")


def follow_file(path, tracker):
    while not os.path.exists(path):
        time.sleep(0.2)

    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        f.seek(0, os.SEEK_SET)
        while True:
            line = f.readline()
            if not line:
                time.sleep(0.1)
                continue

            m = SAMPLE_RE.search(line)
            if m:
                batch = m.group(1)
                tx_id = m.group(2)
                tracker.mark_batch_contains(batch, tx_id)
                continue

            m = COMMIT_RE.search(line)
            if m:
                tracker.mark_batch_committed(m.group(1))


def make_handler(tracker):
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            if not self.path.startswith("/status/"):
                self.send_response(404)
                self.end_headers()
                return

            tx_id = self.path.rsplit("/", 1)[-1]
            if not tx_id.isdigit():
                self.send_response(400)
                self.end_headers()
                return

            payload = json.dumps({"state": tracker.state(tx_id)}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        def log_message(self, fmt, *args):
            return

    return Handler


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--log", required=True)
    parser.add_argument("--port", type=int, required=True)
    args = parser.parse_args()

    tracker = Tracker()
    t = threading.Thread(target=follow_file, args=(args.log, tracker), daemon=True)
    t.start()

    server = ThreadingHTTPServer(("0.0.0.0", args.port), make_handler(tracker))
    server.serve_forever()


if __name__ == "__main__":
    main()
