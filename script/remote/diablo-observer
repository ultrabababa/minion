# Actions - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

start() {
	local dir pid config addr ip port blockchain script started connected

	if [ $# -gt 0 ] ; then
	fatal "unexpected operand '$1'"
	fi

	dir="${deploy_root}"
	if [ ! -d "${dir}" ] ; then
	return 0
    fi

	addr="$(cat "${dir}/primary")"
	ip="$(echo "${addr}" | cut -d':' -f1)"
	port="$(echo "${addr}" | cut -d':' -f2)"
    blockchain="$(cat "${dir}/blockchain")"
    failures="$(cat "${dir}/failures")"
	mode="$(cat "${dir}/mode")"
	nodenum="$(cat "${dir}/nodenum")"
	script="${dir}/${blockchain}"
	started=0
	: > "${dir}/out"
	: > "${dir}/err"

	for attempt in {1..5}
	do
		python3 -u "${deploy_root}/observer.py" "${ip}" "${port}" "${script}" "${failures}" "133" "${mode}" "${nodenum}" >> "${dir}/out" 2>> "${dir}/err" &
		pid=$!
		connected=0

		for check in {1..30}
		do
			sleep 1
			if grep -q '^connected$' "${dir}/out" 2> '/dev/null'; then
				connected=1
				break
			fi
			if [[ -z $pid ]] || ! kill -0 "$pid" 2> '/dev/null'; then
				break
			fi
		done

		if [ ${connected} -eq 1 ]; then
			echo ${pid} > "${dir}/pid"
			started=1
			break
		fi

		if [[ -n $pid ]] && kill -0 "$pid" 2> '/dev/null'; then
			kill "$pid" 2> '/dev/null' || true
		fi
		echo "############## observer not connected, restarting ##############"
		tail -20 "${dir}/err" >&2 || true
	done

	if [ ${started} -eq 0 ] ; then
		echo "############## observer failed to start ##############" >&2
		tail -80 "${dir}/err" >&2 || true
		fatal "observer failed to start after retries"
	fi

    sleep 10
}

_kill() {
	local sig="$1" ; shift
	local dir pid dead

	dir="${deploy_root}"

    if [ ! -d "${dir}" ] ; then
	return 0
    elif [ ! -e "${dir}/pid" ] ; then
	return 0
    fi

	pid="$(cat "${dir}/pid")"

	if echo "${pid}" | grep -Pq '^\d+$' ; then
		kill "${sig}" ${pid} 2> '/dev/null' || true
	fi

	dead=0
	for i in $(seq 1 5) ; do
		if ! ps ${pid} > '/dev/null' ; then
		dead=1
		break
		fi

		sleep 1
	done

	if [ ${dead} -eq 0 ] ; then
		kill -KILL ${pid} 2> '/dev/null' || true
	fi

	rm "${dir}/pid"
}

stop() {
	if [ $# -gt 0 ] ; then
	fatal "unexpected operand '$1'"
	fi

	_kill -INT
}

nkill() {
	if [ $# -gt 0 ] ; then
	fatal "unexpected operand '$1'"
	fi

	_kill -KILL
}


# Main script - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# setup_environment

if [ $# -lt 1 ] ; then
	fatal "missing action operand"
fi

action="$1" ; shift

case "${action}" in
	'kill')
	nkill "$@"
	;;
	'start')
	start "$@"
	;;
	'stop')
	stop "$@"
	;;
	*)
	fatal "unknown action: '${action}'"
	;;
esac
